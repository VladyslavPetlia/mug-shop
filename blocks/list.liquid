{% style %}
  .the-ul-lists-wrapper {
    width: 100%;
  }

  .the-ul-lists {
    width: 100%;
  }
{% endstyle %}

<div class="the-ul-lists-wrapper" {{ block.shopify_attributes }}>
  <h2
    class="list-heading color-{{- block.settings.color_scheme -}}{% if block.settings.css_class %} {{ block.settings.css_class }}{% endif %}"
    style="text-align: {{block.settings.align}}; font-size: {{block.settings.size}}px; margin-top: {{ block.settings.margin_top }}; margin-bottom: {{ block.settings.margin_bottom }}; font-weight: {{block.settings.font_weight}};"
  >
    {{ block.settings.text_heading }}
  </h2>
  <ul class="the-ul-lists">
    {% content_for 'blocks' %}
  </ul>
</div>
{% schema %}
{
  "name": "List",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "text_heading",
      "label": "List Heading",
      "default": "Ingredients:"
    },
    {
      "type": "text_alignment",
      "id": "align",
      "label": "Text Align",
      "default": "left"
    },
    {
      "type": "range",
      "id": "size",
      "label": "Size",
      "min": 8,
      "max": 26,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font Weight",
      "options": [
        {
          "label": "200",
          "value": "200"
        },
        {
          "label": "300",
          "value": "300"
        },
        {
          "label": "400",
          "value": "400"
        },
        {
          "label": "500",
          "value": "500"
        },
        {
          "label": "600",
          "value": "600"
        },
        {
          "label": "700",
          "value": "700"
        },
        {
          "label": "800",
          "value": "800"
        },
        {
          "label": "900",
          "value": "900"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 25,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 25,
      "step": 1,
      "default": 0,
      "unit": "px"
    }
  ],
  "blocks": [{ "type": "item" }],
  "presets": [
    {
      "name": "List"
    }
  ]
}
{% endschema %}
