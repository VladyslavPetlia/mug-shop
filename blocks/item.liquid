{% style %}
  .the-ul-lists-item {
    width: 100%;
    font-size: {{ block.settings.size }}px;
    margin-top: {{ block.settings.margin_top }}px;
    margin-bottom: {{ block.settings.margin_bottom }}px;
    font-weight: {{ block.settings.font_weight }};
    font-family: {{ block.settings.font.family }};
    list-style-type: {{ block.settings.list_style }};
  }

  .the-ul-lists-item__inner {
    text-align: {{ block.settings.text_align }};
    width: 100%;
  }
{% endstyle %}

<li
  class="the-ul-lists-item color-{{- block.settings.color_scheme -}}{% if block.settings.css_class %} {{ block.settings.css_class }}{% endif %}"
  {{ block.shopify_attributes }}
>
  <div class="the-ul-lists-item__inner">
    {{ block.settings.text }}
  </div>
</li>

{% schema %}
{
  "name": "item",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "List Item",
      "default": "List item text"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text Align",
      "options": [
        {
          "label": "left",
          "value": "left"
        },
        {
          "label": "center",
          "value": "center"
        },
        {
          "label": "right",
          "value": "right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "list_style",
      "label": "List Style",
      "options": [
        {
          "label": "none",
          "value": "none"
        },
        {
          "label": "disc",
          "value": "disc"
        },
        {
          "label": "circle",
          "value": "circle"
        },
        {
          "label": "square",
          "value": "square"
        },
        {
          "label": "decimal",
          "value": "decimal"
        },
        {
          "label": "decimal-leading-zero",
          "value": "decimal-leading-zero"
        },
        {
          "label": "upper-roman",
          "value": "upper-roman"
        },
        {
          "label": "lower-latin",
          "value": "lower-latin"
        },
        {
          "label": "upper-latin",
          "value": "upper-latin"
        }
      ],
      "default": "disc"
    },
    {
      "type": "range",
      "id": "size",
      "label": "Size",
      "min": 8,
      "max": 26,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font Weight",
      "options": [
        {
          "label": "200",
          "value": "200"
        },
        {
          "label": "300",
          "value": "300"
        },
        {
          "label": "400",
          "value": "400"
        },
        {
          "label": "500",
          "value": "500"
        },
        {
          "label": "600",
          "value": "600"
        },
        {
          "label": "700",
          "value": "700"
        },
        {
          "label": "800",
          "value": "800"
        },
        {
          "label": "900",
          "value": "900"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 25,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 25,
      "step": 1,
      "default": 0,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Item"
    }
  ]
}
{% endschema %}
