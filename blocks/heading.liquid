{% style %}
  #shopify-block-{{ block.id }} .flex-heading-container {
    display: flex;
    width: 100%;
    margin: 0;
    text-shadow: {% if block.settings.shadow %}
      1px 1px 2px {{ block.settings.shadow_color }}
    {% endif %};
    margin-bottom: {{ block.settings.margin_bottom }}px;
    justify-content: {{ block.settings.text_align }};
  }

  @media (max-width: 750px) {
    #shopify-block-{{ block.id }} .flex-heading-container {
      margin-bottom: calc({{ block.settings.margin_bottom }}px / 2);
      justify-content: {{ block.settings.text_align_mobile }};
    }
  }
{% endstyle %}

<div class="flex-heading-container">
  <{{ block.settings.tag }}>
    {{ block.settings.heading }}
  </{{ block.settings.tag }}>
</div>

{% schema %}
{
  "name": "Heading",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Lorem ipsum"
    },
    {
      "type": "select",
      "id": "tag",
      "label": "Tag",
      "options": [
        { "label": "h1", "value": "h1" },
        { "label": "h2", "value": "h2" },
        { "label": "h3", "value": "h3" },
        { "label": "h4", "value": "h4" },
        { "label": "h5", "value": "h5" },
        { "label": "h6", "value": "h6" },
        { "label": "span", "value": "span" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text align",
      "options": [
        { "label": "left", "value": "start" },
        { "label": "center", "value": "center" },
        { "label": "right", "value": "end" }
      ],
      "default": "start"
    },
    {
      "type": "checkbox",
      "id": "shadow",
      "label": "Text Shadow",
      "default": false,
      "info": "Text Shadow ON or OFF"
    },
    {
      "type": "color",
      "id": "shadow_color",
      "label": "Shadow Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "select",
      "id": "text_align_mobile",
      "label": "Text align",
      "options": [
        { "label": "left", "value": "left" },
        { "label": "center", "value": "center" },
        { "label": "right", "value": "right" }
      ],
      "default": "left"
    }
  ],
  "presets": [{ "name": "Heading" }]
}
{% endschema %}
