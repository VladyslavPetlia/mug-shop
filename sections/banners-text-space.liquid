{{ 'banners-text-space.css' | asset_url | stylesheet_tag }}
{% style %}
  .overlay {
    position: absolute;
    top: 0;
    right: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, {{ section.settings.overlay_opacity }}%);
  }
{% endstyle %}
<div class="page-width banner-text-space_main">
  {% for block in section.blocks %}
    {% if block.type == 'banner-text-space' %}
      <div
        class="banner-text-space_block color-{{ section.settings.color_scheme }} gradient"
        {{ block.shopify_attributes }}
      >
        <div class="banner-text-space-content_block">
          {% if block.settings.heading != blank %}
            <h2 class="banner-text-space-title_block">
              {{ block.settings.heading | escape }}
            </h2>
          {% endif %}

          {% if block.settings.description != blank %}
            <div class="banner-text-space-description_block">
              {{ block.settings.description }}
            </div>
          {% endif %}

          {% if block.settings.button_label != blank and block.settings.button_url != blank %}
            <a class="" href="{{ block.settings.button_url }}">
              <button class="button">
                {{ block.settings.button_label | escape }}
              </button>
            </a>
          {% endif %}
        </div>

        {%- comment -%} Background Media Image Layer {%- endcomment -%}
        {% if block.settings.banner_image != blank %}
          {{
            block.settings.banner_image
            | image_url: width: 700
            | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw'
          }}
        {% else %}
          {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
        <div class="overlay"><div></div></div>
      </div>
    {% endif %}
  {% endfor %}
</div>

{% schema %}
{
  "name": "Banners-Text-Space",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "info": "Optional. Banners are self explanatory."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-6"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Overlay Opacity",
      "default": 10
    }
  ],
  "blocks": [
    {
      "type": "banner-text-space",
      "name": "Banner",
      "limit": 8,
      "settings": [
        {
          "type": "image_picker",
          "id": "banner_image",
          "label": "Banner Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Title",
          "info": "Banner Heading"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Bottom Description",
          "default": "<p>Bottom Description</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "info": "Leave blank to hide",
          "default": "Button"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Link",
          "info": "Leave blank to hide"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Banners-Text-Space",
      "blocks": [
        {
          "type": "banner-text-space"
        },
        {
          "type": "banner-text-space"
        }
      ]
    }
  ]
}
{% endschema %}
