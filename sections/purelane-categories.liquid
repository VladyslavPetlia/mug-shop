{{ 'purelane-categories.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane-reveal.js' | asset_url }}" defer="defer"></script>

{% style %}
  .pl {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .pl-head {
    text-align: {{ section.settings.header_align }};
  }
{% endstyle %}

{%- assign anchor = section.settings.anchor | default: section.id | handleize -%}

<div
  class="pl pl-sec page-width color-{{ section.settings.color_scheme }}"
  id="{{ anchor }}"
  data-pl-scene="{{ section.settings.scene }}"
>
  <div class="pl-wrap">
    {%- if section.settings.kicker != blank or section.settings.heading != blank -%}
      <div class="pl-head pl-rv">
        {%- if section.settings.kicker != blank -%}
          <span class="pl-kicker">{{ section.settings.kicker }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="pl-d2">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="pl-cats">
        {%- for block in section.blocks -%}
          {%- liquid
            assign picked = block.settings.product
            assign delay = forloop.index0 | modulo: 4
            assign art = forloop.index0 | modulo: 3 | plus: 1
            assign fallback = 'purelane-bottle-placeholder-' | append: art | append: '.svg'
          -%}
          <a
            class="pl-glass color-{{ section.settings.color_scheme }} pl-cat pl-rv{% if delay > 0 %} pl-rv-d{{ delay }}{% endif %}"
            href="{{ block.settings.link | default: '#' }}"
            {{ block.shopify_attributes }}
          >
            <span class="pl-cat__shot">
              {%- if picked.featured_media -%}
                {{
                  picked.featured_media
                  | image_url: height: 540
                  | image_tag: widths: '180, 260, 380', sizes: '(min-width: 900px) 22vw, 44vw', loading: 'lazy', alt: ''
                }}
              {%- else -%}
                <img src="{{ fallback | asset_url }}" alt="" width="380" height="1177" loading="lazy" decoding="async">
              {%- endif -%}
            </span>
            <span class="pl-cat__txt">
              {%- if block.settings.heading != blank -%}
                <span class="pl-cat__title">{{ block.settings.heading }}</span>
              {%- endif -%}
              {%- if block.settings.note != blank -%}
                <span class="pl-cat__note">{{ block.settings.note }}</span>
              {%- endif -%}
            </span>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Categories",
  "tag": "section",
  "class": "pl-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bundle categories"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find the right bundle for you"
    },
    {
      "type": "select",
      "id": "header_align",
      "label": "Header Align",
      "options": [
        {
          "value": "left",
          "label": "left"
        },
        {
          "value": "center",
          "label": "center"
        },
        {
          "value": "right",
          "label": "right"
        }
      ],
      "default": "left",
      "info": "Align Header and kicker"
    },
    {
      "type": "header",
      "content": "Content for Header"
    },
    {
      "type": "range",
      "id": "scene",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 4,
      "label": "Scene"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor",
      "default": "categories"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 10,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 10,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Kitchen bundle"
        },
        {
          "type": "text",
          "id": "note",
          "label": "Note"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Categories",
      "blocks": [
        { "type": "category", "settings": { "heading": "Kitchen bundle", "note": "Grease, dishes & more" } },
        { "type": "category", "settings": { "heading": "Bathroom bundle", "note": "Deep clean & disinfect" } },
        { "type": "category", "settings": { "heading": "Laundry bundle", "note": "Softer, fresher wash" } },
        { "type": "category", "settings": { "heading": "Hard water bundle", "note": "Melt away limescale" } }
      ]
    }
  ]
}
{% endschema %}
